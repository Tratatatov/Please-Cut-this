  DialoguePhrases:
  - text: "\u042D\u043C.. \u041F\u0440\u0438\u0432\u0435\u0442"
    delayOverride: 2
  - text: "\u042F \u0442\u0443\u0442 \u0437\u0430\u043F\u0438\u0441\u0430\u043B...
      \u041D\u0443 \u0434\u0435\u0432\u0443\u0448\u043A\u0443 \u0432\u043E\u043E\u0431\u0449\u0435\u043C. "
    delayOverride: 3
  - text: "\u041E\u043D\u0430..\u043F\u0440\u043E\u0441\u0442\u043E \u041D\u0415\u0427\u0422\u041E!
      \u041D\u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u0441
      \u043F\u043B\u0435\u043D\u043A\u043E\u0439 \u0447\u0442\u043E \u0442\u043E
      \u043D\u0435 \u0442\u043E. "
    delayOverride: 3
  - text: "\u041C\u043E\u0436\u0435\u0442 \u044F \u0435\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0447\u0430\u0441\u0442\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u0438
      \u043E\u043D\u0430 \u0441\u043B\u043E\u043C\u0430\u043B\u0430\u0441\u044C?"
    delayOverride: 3
  ArrivalPhrases: []
  SuccessPhrase: "\u041E\u043E\u043E, \u0441\u043A\u043E\u0440\u0435\u0435 \u043F\u043E\u043B\u0435\u0447\u0443
