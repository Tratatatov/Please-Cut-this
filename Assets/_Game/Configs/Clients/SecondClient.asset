  m_Script: {fileID: 11500000, guid: 152e30b9cfb44d846a7339c4adb2fe9a, type: 3}
  m_Name: SecondClient
  m_EditorClassIdentifier: 
  ClientName: "\u041A\u043B\u0438\u0435\u043D\u0442"
  ModelType: 0
  PhraseDelay: 2.5
  DialoguePhrases:
  - text: "\u042D\u0439 \u043F\u0440\u0438\u0432\u0435\u0442. \u042F \u0441\u043B\u044B\u0448\u0430\u043B
      \u0442\u044B \u0442\u0443\u0442 \u043A\u0430\u0441\u0441\u0435\u0442\u043D\u044B\u0445
      \u0434\u0435\u043B \u043C\u0430\u0441\u0442\u0435\u0440?"
    delayOverride: 1.5
  - text: "\u041A\u043E\u0440\u043E\u0447\u0435 \u0443 \u043C\u0435\u043D\u044F \u0434\u043E\u0447\u0443\u0440\u043A\u0430
      \u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u0443 \u043D\u0435\u0435 \u0441\u043A\u0430\u0437\u043A\u0430
      \u0441\u043B\u043E\u043C\u0430\u043B\u0430\u0441\u044C."
    delayOverride: 1.5
  - text: "\u042F \u0442\u043E \u043D\u0435 \u043C\u043E\u043B\u043E\u0434\u0435\u0436,
      \u0432 \u0432\u0430\u0448\u0438\u0445 \u0448\u0442\u0443\u043A\u0430\u0445
      \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E. \u042F \u0435\u0439
      \u0442\u0430\u043A \u0438 \u0441\u043A\u0430\u0437\u0430\u043B."
    delayOverride: 2
  - text: "\u0410 \u043E\u043D\u0430 \u043D\u0438 \u0432 \u043A\u0430\u043A\u0443\u044E.
      \u041A\u043E\u0440\u043E\u0447\u0435 \u043F\u043E\u0447\u0438\u043D\u0438,
      \u0430 \u0442\u043E \u043E\u043D\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
      \u044D\u0442\u0443 \u043A\u0430\u0441\u0441\u0435\u0442\u0443 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0446\u0435\u043B\u044B\u043C\u0438 \u0434\u043D\u044F\u043C\u0438."
    delayOverride: 2.5
  ArrivalPhrases: []
  SuccessPhrase: "\u0412\u043E\u0442 \u0434\u043E\u0447\u0443\u0440\u043A\u0430 \u043E\u0431\u0440\u0430\u0434\u0443\u0435\u0442\u0441\u044F!
    \u0425\u043E\u0442\u044C \u043E\u0442\u0441\u0442\u0430\u043D\u0435\u0442 \u0438
    \u0441\u043C\u043E\u0433\u0443 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u041A\u0430\u0440\u043C\u0435\u043B\u0438\u0442\u0443, \u043F\u043E\u043A\u0430
    \u043E\u043D\u0430 \u0437\u0430\u043D\u044F\u0442\u0430. \u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
  LevelData: {fileID: 11400000, guid: c23b04721e12e704a9138393b46e2794, type: 2}
