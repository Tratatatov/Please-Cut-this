  m_Name: ThirdClient
  m_EditorClassIdentifier: 
  ClientName: 
  ModelType: 2
  PhraseDelay: 4
  DialoguePhrases:
  - text: "\u0422\u0443\u0442 \u044D\u0442\u043E. \u0421\u0440\u043E\u0447\u043D\u043E\u0435
      \u0434\u0435\u043B\u043E. "
    delayOverride: 3
  - text: "\u042F \u0442\u0443\u0442 \u043D\u0430\u0448\u0435\u043B \u0432\u0438\u0434\u0435\u043E,
      \u0437\u0430\u0432\u0442\u0440\u0430 \u0443\u0447\u0435\u043D\u0438\u043A\u0430\u043C
      \u0432 \u0448\u043A\u043E\u043B\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C"
    delayOverride: 3
  - text: "\u0410 \u0442\u043E \u043E\u043D\u0438 \u0432 \u0441\u0432\u043E\u0435\u043C
      \u0440\u043E\u043C\u0431\u0443\u043A\u0441\u0435 \u0441 \u043A\u0435\u043C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0442\u0441\u044F"
    delayOverride: 3
  - text: "\u0412\u043E\u043E\u0431\u0449\u0435\u043C \u043F\u043E\u0447\u0438\u043D\u0438,
      \u0430 \u044F \u0442\u0435\u0431\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0435\u043D
      \u0431\u0443\u0434\u0443"
    delayOverride: 3
  ArrivalPhrases: []
  SuccessPhrase: "\u041D\u0443 \u0432\u043E\u0442! \u042D\u0442\u043E \u0432\u043E\u0442
    \u043D\u0430\u0448\u0435 \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u0435
    \u0432\u0441\u0435 \u043C\u043E\u0436\u0435\u0442. \u0421\u043F\u0430\u0441\u0438\u0431\u043E
